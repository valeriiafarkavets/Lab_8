<Window x:Class="Lab_8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Lab_8.Controls"
        Title="Lab 8 - LED Matrix"
        Height="900" Width="1100"
        MinHeight="850" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#101F28">

    <Window.Resources>
        <Style x:Key="TurquoiseButton" TargetType="Button">
            <Setter Property="Background" Value="#2DD4BF"/>
            <Setter Property="Foreground" Value="#102731"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#102731"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#45636D"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="LED MATRIX"
                       FontSize="27"
                       FontWeight="Bold"
                       Foreground="#2DD4BF"/>
            <TextBlock Text="Лабораторна робота №8 | Побітові операції та WPF"
                       FontSize="14"
                       Foreground="#B7C9CE"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#19343E"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">

            <StackPanel>
                <TextBlock Text="Світлодіодний рядок 64 × 10"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,0,0,12"/>

                <controls:LedMatrixControl x:Name="LedDisplay"
                                           Height="130"
                                           HorizontalAlignment="Stretch"/>

                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="MessageTextBox"
                             Grid.Column="0"
                             Style="{StaticResource DarkTextBox}"
                             Text="NORDIC 2026"
                             VerticalContentAlignment="Center"
                             Margin="0,0,12,0"/>

                    <Button x:Name="StartButton"
                            Grid.Column="1"
                            Content="СТАРТ"
                            Style="{StaticResource TurquoiseButton}"
                            Click="StartButton_Click"
                            Margin="0,0,8,0"/>

                    <Button x:Name="StopButton"
                            Grid.Column="2"
                            Content="СТОП"
                            Style="{StaticResource TurquoiseButton}"
                            Click="StopButton_Click"/>
                </Grid>

                <StackPanel Orientation="Horizontal"
                            Margin="0,14,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Швидкість:"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                    <Slider x:Name="SpeedSlider"
                            Width="220"
                            Minimum="1"
                            Maximum="10"
                            Value="5"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            ValueChanged="SpeedSlider_ValueChanged"
                            Margin="15,0,10,0"/>

                    <TextBlock x:Name="SpeedText"
                               Text="5"
                               Foreground="#2DD4BF"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#19343E"
                    CornerRadius="8"
                    Padding="16">

                <StackPanel>
                    <TextBlock Text="Редактор символу 8 × 10"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,12,0,12">
                        <TextBlock Text="Символ:"
                                   Foreground="#B7C9CE"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <TextBox x:Name="SymbolTextBox"
                                 Style="{StaticResource DarkTextBox}"
                                 Width="65"
                                 MaxLength="1"
                                 Text="A"
                                 TextAlignment="Center"/>

                        <Button Content="ЗАВАНТАЖИТИ"
                                Style="{StaticResource TurquoiseButton}"
                                Margin="12,0,0,0"
                                Click="LoadSymbolButton_Click"/>
                    </StackPanel>

                    <UniformGrid x:Name="EditorGrid"
                                 Rows="10"
                                 Columns="8"
                                 Width="280"
                                 Height="280"
                                 HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#19343E"
                    CornerRadius="8"
                    Padding="16">

                <StackPanel>
                    <TextBlock Text="HEX-код символу"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="10 байтів у шістнадцятковому форматі"
                               Foreground="#B7C9CE"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,8,0,12"/>

                    <TextBox x:Name="HexTextBox"
                             Style="{StaticResource DarkTextBox}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="110"
                             VerticalScrollBarVisibility="Auto"/>

                    <Button Content="ЗАСТОСУВАТИ HEX"
                            Style="{StaticResource TurquoiseButton}"
                            Margin="0,12,0,0"
                            Click="ApplyHexButton_Click"/>

                    <Button Content="ЗБЕРЕГТИ СИМВОЛ"
                            Style="{StaticResource TurquoiseButton}"
                            Margin="0,10,0,0"
                            Click="SaveSymbolButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="#19343E"
                CornerRadius="6"
                Padding="12"
                Margin="0,16,0,0">

            <TextBlock x:Name="StatusText"
                       Text="Готово до роботи"
                       Foreground="#2DD4BF"
                       FontSize="13"/>
        </Border>
    </Grid>
</Window>
